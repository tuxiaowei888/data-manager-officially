# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 必需配置（生产环境必须设置）
# ============================================

# JWT 密钥（生产环境必须修改，建议使用随机生成的长字符串）
# 可以使用: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-characters

# 数据库连接URL
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/shuwei_data_manager?charset=utf8mb4

# ============================================
# 可选配置（有默认值）
# ============================================

# 数据库配置（如果不使用DATABASE_URL，可以单独配置）
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=shuwei_data_manager

# 应用配置
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
