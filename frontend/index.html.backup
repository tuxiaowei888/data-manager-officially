                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="rights_cert" value="无" required>
                                <label class="form-check-label">无</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="rights_cert" value="政府授权运营书">
                                <label class="form-check-label">政府授权运营书</label>
                            </div>
