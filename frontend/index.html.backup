                    <button type="button" class="btn btn-primary-custom btn-custom ms-auto" id="nextBtn">
                        下一步 <i class="bi bi-arrow-right"></i>
                    </button>
                    <button type="submit" class="btn btn-success-custom btn-custom ms-auto" id="submitBtn" style="display: none;">
