/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-primary);
}

.login-section {
  padding: 120rpx 40rpx 60rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 100rpx;
}

.logo-wrapper {
  position: relative;
  display: inline-block;
}

.logo-icon {
  width: 200rpx;
  height: 200rpx;
  background: var(--gradient-brand);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(27, 58, 87, 0.3);
}

.logo-text {
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(27, 58, 87, 0.2);
}

.logo-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.2) 0%, transparent 70%);
  animation: logoBreathe 3s ease-in-out infinite;
}

@keyframes logoBreathe {
  0%, 100% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
}

.title {
  display: block;
  font-size: var(--font-l1);
  font-weight: bold;
  color: var(--primary-color);
  margin-top: 30rpx;
  letter-spacing: -1px;
}

.subtitle {
  display: block;
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-top: 16rpx;
}

.login-form {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 50rpx 40rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
}

.input-group {
  margin-bottom: 30rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  padding: 0 30rpx;
  font-size: var(--font-body);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input:focus {
  border-color: var(--primary-color);
}

.input::after {
  display: none;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: var(--font-l3);
  font-weight: 500;
  margin-top: 30rpx;
  box-shadow: var(--shadow-button);
  transition: all 0.2s ease;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary::after {
  display: none;
}

.link {
  display: block;
  text-align: center;
  color: var(--primary-color);
  font-size: var(--font-body);
  margin-top: 30rpx;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.home-section {
  padding: var(--spacing-md);
}

.welcome-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  border-radius: var(--radius-xl);
  padding: 50rpx 40rpx;
  color: #fff;
  margin-bottom: var(--spacing-md);
  position: relative;
  overflow: hidden;
}

.welcome-card::before {
  content: "";
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(0, 210, 255, 0.3) 0%, transparent 70%);
  border-radius: 50%;
}

.welcome-card::after {
  content: "";
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.welcome-text {
  font-size: var(--font-l2);
  font-weight: bold;
  position: relative;
  z-index: 1;
}

.welcome-sub {
  font-size: var(--font-meta);
  opacity: 0.9;
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: var(--primary-color);
  font-size: var(--font-meta);
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  margin-left: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.3);
}

.vip-badge::before {
  content: "⭐";
  margin-right: 6rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.stat-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx 20rpx;
  text-align: center;
  margin: 0 10rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
  position: relative;
  overflow: hidden;
}

.stat-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--gradient-tech);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.stat-item:active::before {
  opacity: 1;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  font-family: var(--font-family-num);
}

.stat-label {
  display: block;
  font-size: var(--font-meta);
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.btn-start {
  width: 100%;
  height: 112rpx;
  background: var(--gradient-brand);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-l2);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
  box-shadow: 0 8rpx 24rpx rgba(27, 58, 87, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn-start::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s ease;
}

.btn-start:active::before {
  left: 100%;
}

.btn-start:active {
  transform: scale(0.98);
}

.btn-start-text {
  position: relative;
  z-index: 1;
}

.btn-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}

.section-title {
  font-size: var(--font-l3);
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 20rpx;
  display: block;
}

.report-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
}

.report-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: background 0.2s ease;
}

.report-item:active {
  background: var(--bg-primary);
}

.report-item:last-child {
  border-bottom: none;
}

.report-info {
  flex: 1;
}

.report-org {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 500;
  display: block;
}

.report-meta {
  font-size: var(--font-meta);
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
}

.report-right {
  display: flex;
  align-items: center;
}

.report-score {
  font-size: 36rpx;
  font-weight: bold;
  font-family: var(--font-family-num);
  margin-right: 20rpx;
}

.report-score.high {
  color: var(--success-color);
}

.report-score.mid {
  color: var(--warning-color);
}

.report-score.low {
  color: var(--danger-color);
}

.report-arrow {
  color: var(--text-disabled);
  font-size: 28rpx;
}

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: var(--font-body);
  color: var(--text-secondary);
}
