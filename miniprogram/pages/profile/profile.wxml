<!--profile.wxml-->
<view class="container">
  <view class="profile-header">
    <view class="avatar-wrapper">
      <view class="avatar">
        <text class="avatar-text">👤</text>
      </view>
      <view class="avatar-status"></view>
    </view>
    <text class="username">{{userInfo.username}}</text>
    <text class="user-info">{{userInfo.email}}</text>
    <text class="vip-tag" wx:if="{{userInfo.is_vip}}">VIP会员</text>
  </view>
  
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{vipStatus.remaining}}</text>
      <text class="stat-label">剩余次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{vipStatus.total_evaluations}}</text>
      <text class="stat-label">总评估</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{vipStatus.total_reports}}</text>
      <text class="stat-label">报告数</text>
    </view>
  </view>
  
  <view class="menu-section">
    <text class="menu-title">功能菜单</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="viewHistory">
        <view class="menu-icon blue">📋</view>
        <text class="menu-text">评估历史</text>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="viewReports">
        <view class="menu-icon green">📊</view>
        <text class="menu-text">我的报告</text>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="goToWeb">
        <view class="menu-icon tech">💻</view>
        <text class="menu-text">电脑端管理</text>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon orange">📞</view>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
  
  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  
  <view class="version-info">
    <text>数维数据管家 v1.0.0</text>
  </view>
</view>
