/* 数维数据管家 - 小程序全局样式 */
/* 设计规范：理性科技 + 权威信赖 */

/* ========== CSS 变量系统 ========== */
page {
  /* 主色调 - 深空蓝 */
  --primary-color: #1B3A57;
  --primary-dark: #0F4C81;
  --primary-light: #2E5A7C;

  /* 辅助科技色 - 青色光 */
  --tech-accent: #00D2FF;
  --tech-secondary: #4ECDC4;

  /* 数据增值色 - 翡翠绿 */
  --success-color: #2ECC71;
  --success-light: #58D68D;

  /* 风险警示色 */
  --danger-color: #FF6B6B;
  --danger-light: #FFB3B3;
  --warning-color: #FF9F43;

  /* 中性色 - 背景 */
  --bg-primary: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-dark: #0B1120;

  /* 中性色 - 文字 */
  --text-primary: #1B3A57;
  --text-secondary: #5A6C7D;
  --text-disabled: #99A8B8;

  /* 中性色 - 边框 */
  --border-light: #E8EDF2;
  --border-focus: #1B3A57;

  /* 渐变 */
  --gradient-brand: linear-gradient(135deg, #1B3A57 0%, #00D2FF 100%);
  --gradient-deep: linear-gradient(180deg, #0B1120 0%, #1B3A57 100%);
  --gradient-tech: linear-gradient(135deg, #00D2FF 0%, #4ECDC4 100%);
  --gradient-success: linear-gradient(135deg, #2ECC71 0%, #58D68D 100%);

  /* 阴影 */
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  --shadow-hover: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  --shadow-button: 0 4rpx 12rpx rgba(27, 58, 87, 0.3);

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-full: 9999rpx;

  /* 字体 */
  --font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans", "Microsoft YaHei", sans-serif;
  --font-family-num: "Roboto Mono", "DIN Alternate", "SF Mono", monospace;

  /* 字号 */
  --font-l1: 48rpx;
  --font-l2: 36rpx;
  --font-l3: 32rpx;
  --font-body: 28rpx;
  --font-meta: 24rpx;
  --font-xs: 22rpx;

  /* 间距 */
  --spacing-xs: 10rpx;
  --spacing-sm: 20rpx;
  --spacing-md: 30rpx;
  --spacing-lg: 40rpx;
  --spacing-xl: 60rpx;

  /* 全局背景 */
  background-color: var(--bg-primary);
  font-family: var(--font-family);
  font-size: var(--font-body);
  color: var(--text-primary);
}

/* ========== 通用组件 ========== */

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
}

.card-hover {
  transition: all 0.3s ease;
}

.card-hover:active {
  box-shadow: var(--shadow-hover);
  transform: translateY(-2rpx);
}

/* 主按钮 */
.btn-primary {
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: var(--font-l3);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-button);
  transition: all 0.2s ease;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary::after {
  display: none;
}

/* 次按钮 */
.btn-secondary {
  background: var(--bg-primary);
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  font-size: var(--font-l3);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: var(--border-light);
  transform: scale(0.98);
}

.btn-secondary::after {
  display: none;
}

/* 成功按钮 */
.btn-success {
  background: var(--gradient-success);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: var(--font-l3);
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(46, 204, 113, 0.3);
}

/* 输入框 */
.input-field {
  width: 100%;
  height: 80rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-sm);
  font-size: var(--font-body);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input-field:focus {
  border-color: var(--border-focus);
}

.input-field::after {
  display: none;
}

/* 标签 */
.label {
  font-size: var(--font-body);
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
  font-weight: 500;
}

/* 标题 */
.title-l1 {
  font-size: var(--font-l1);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.5px;
}

.title-l2 {
  font-size: var(--font-l2);
  font-weight: 600;
  color: var(--text-primary);
}

.title-l3 {
  font-size: var(--font-l3);
  font-weight: 600;
  color: var(--text-primary);
}

/* 副标题 */
.subtitle {
  font-size: var(--font-meta);
  color: var(--text-secondary);
}

/* ========== 动效 ========== */

/* 页面进入 - 向上浮入 */
.page-enter {
  opacity: 0;
  transform: translateY(20rpx);
}

.page-enter-active {
  animation: pageEnter 0.3s ease forwards;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 数字滚动效果 */
.number-animate {
  display: inline-block;
  animation: numberRoll 0.6s ease-out;
}

@keyframes numberRoll {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 按钮点击反馈 */
.btn-active:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--border-light) 25%,
    var(--bg-card) 50%,
    var(--border-light) 75%
  );
  background-size: 200% 100%;
  animation: skeletonLoading 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeletonLoading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--tech-accent);
  margin: 0 8rpx;
  animation: loadingBounce 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes loadingBounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* ========== 特殊组件 ========== */

/* AI 呼吸灯效 */
.ai-breathing {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(0, 210, 255, 0.3) 0%,
    transparent 70%);
  animation: aiBreathe 2s ease-in-out infinite;
}

@keyframes aiBreathe {
  0%, 100% { transform: scale(0.95); opacity: 0.6; }
  50% { transform: scale(1.05); opacity: 1; }
}

/* AI 建议标记 */
.ai-suggestion {
  position: relative;
  padding-left: 36rpx;
}

.ai-suggestion::before {
  content: "✨";
  position: absolute;
  left: 0;
  top: 0;
  font-size: var(--font-body);
}

/* 风险警示 - P0 */
.alert-p0 {
  background: rgba(255, 107, 107, 0.1);
  border: 2rpx solid var(--danger-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  animation: p0Flash 2s ease-in-out infinite;
}

@keyframes p0Flash {
  0%, 100% { border-color: var(--danger-color); }
  50% { border-color: var(--danger-light); }
}

/* 风险警示 - P1 */
.alert-p1 {
  background: rgba(255, 159, 67, 0.1);
  border: 2rpx solid var(--warning-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
}

/* 知识库引用 */
.citation-block {
  background: rgba(0, 210, 255, 0.05);
  border-left: 6rpx solid var(--tech-accent);
  padding: var(--spacing-sm) var(--spacing-md);
  margin: var(--spacing-sm) 0;
  position: relative;
}

.citation-source {
  display: block;
  margin-top: var(--spacing-xs);
  font-size: var(--font-meta);
  color: var(--text-secondary);
}

.citation-source::before {
  content: "[来源：";
}

.citation-source::after {
  content: "]";
}

/* 等级徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: var(--font-body);
}

.badge-gold {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.3);
}

.badge-silver {
  background: linear-gradient(135deg, #C0C0C0 0%, #808080 100%);
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(192, 192, 192, 0.3);
}

.badge-bronze {
  background: linear-gradient(135deg, #CD7F32 0%, #8B4513 100%);
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(205, 127, 50, 0.3);
}

.badge-iron {
  background: linear-gradient(135deg, #4A4A4A 0%, #2C2C2C 100%);
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(74, 74, 74, 0.3);
}

/* 进度条 */
.progress-bar {
  height: 16rpx;
  background: var(--border-light);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--gradient-brand);
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.progress-fill.success {
  background: var(--gradient-success);
}

/* 分段式进度条 */
.progress-segmented {
  display: flex;
  justify-content: space-between;
}

.progress-node {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--border-light);
  transition: all 0.3s ease;
}

.progress-node.completed {
  background: var(--success-color);
  box-shadow: 0 0 16rpx rgba(46, 204, 113, 0.4);
}

/* ========== 工具类 ========== */

/* 文字颜色 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-success { color: var(--success-color); }
.text-danger { color: var(--danger-color); }
.text-warning { color: var(--warning-color); }
.text-tech { color: var(--tech-accent); }

/* 背景 */
.bg-card { background: var(--bg-card); }
.bg-primary { background: var(--bg-primary); }
.bg-gradient { background: var(--gradient-brand); }

/* Flex 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.flex-1 { flex: 1; }

/* 间距 */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }

/* 数字字体 */
.num {
  font-family: var(--font-family-num);
  font-variant-numeric: tabular-nums;
}
